# =============================================================================
# PHASE 2 SPRINT 1: Environment Configuration Example
# =============================================================================
# Copy this file to .env and update with your actual values
#
# cp .env.example .env
# =============================================================================

# =============================================================================
# REDIS & CELERY CONFIGURATION
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Celery broker (same as Redis)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend (same as Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Worker settings
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# =============================================================================
# EXISTING CONFIGURATION (from previous phases)
# =============================================================================

# API Keys
FAL_KEY=your_fal_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Security
MIN_AGE_THRESHOLD=25
EPHEMERAL_STORAGE_PATH=./ephemeral_storage

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Processing
MAX_VIDEO_SIZE_MB=500
NUM_FRAMES_TO_EXTRACT=5
LAPLACIAN_VARIANCE_THRESHOLD=100.0

# Celebrity Blocker (Week 4)
CELEBRITY_DB_PATH=celebrity_embeddings.pkl
CELEBRITY_THRESHOLD=0.85

# Monitoring (Week 4)
ENVIRONMENT=production
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Payment Gateways (Week 4)
CCBILL_MERCHANT_ID=your_ccbill_merchant_id
CCBILL_SUBACCOUNT=your_ccbill_subaccount
CCBILL_WEBHOOK_SECRET=your_ccbill_webhook_secret

SEGPAY_MERCHANT_ID=your_segpay_merchant_id
SEGPAY_API_KEY=your_segpay_api_key
SEGPAY_WEBHOOK_SECRET=your_segpay_webhook_secret

EPOCH_MERCHANT_ID=your_epoch_merchant_id
EPOCH_API_KEY=your_epoch_api_key
EPOCH_WEBHOOK_SECRET=your_epoch_webhook_secret

# =============================================================================
# PHASE 2 SPRINT 1: NEW SETTINGS
# =============================================================================

# Task timeouts (seconds)
CELERY_TASK_TIME_LIMIT=600          # 10 minutes hard limit
CELERY_TASK_SOFT_TIME_LIMIT=540     # 9 minutes soft limit

# Result expiration (seconds)
CELERY_RESULT_EXPIRES=3600          # 1 hour

# Worker memory limits (bytes)
CELERY_WORKER_MAX_MEMORY_PER_CHILD=2000000  # 2GB

# Worker task limits
CELERY_WORKER_MAX_TASKS_PER_CHILD=10

# Flower monitoring
FLOWER_PORT=5555
FLOWER_PERSISTENT=True

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# =============================================================================

# Redis persistence
REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Celery logging
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_LOG_FORMAT=[%(asctime)s: %(levelname)s/%(processName)s] %(message)s

# Task routing
CELERY_DEFAULT_QUEUE=default
CELERY_VIDEO_QUEUE=video_generation
CELERY_MAINTENANCE_QUEUE=maintenance

# Rate limiting (tasks per time unit)
CELERY_TASK_DEFAULT_RATE_LIMIT=10/m  # 10 tasks per minute
